{
  "manifest_version": 3,
  "name": "JobForm Autofill",
  "version": "0.1.0",
  "description": "Detecta campos de formularios de postulaciones laborales.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "JobForm Autofill",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "scripts": ["background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jobform-autofill@example.com",
      "strict_min_version": "109.0"
    }
  }
}
